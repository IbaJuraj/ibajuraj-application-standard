{
  "$schema": "./STANDARD_CONFORMANCE.schema.json",
  "standardVersion": "1.9.0",
  "standardCandidate": "RC4",
  "app": {
    "name": "<App Name>",
    "productId": "<product-id>",
    "version": "<marketing-version>",
    "build": "<build>",
    "sourceRevision": "<git-sha-or-source-tree-digest>"
  },
  "capabilities": {
    "hasSettings": true,
    "hasAppearance": true,
    "hasCustomThemes": false,
    "hasLocalization": true,
    "hasLocalizedSearch": false,
    "hasBottomNavigation": false,
    "bottomNavigationMode": "none",
    "hasBottomPrimaryAction": false,
    "supportsIPad": false,
    "requiresIPadCompatibilityTest": false,
    "supportsResizableWindow": false,
    "hasCalculatorKeypad": false,
    "hasForms": false,
    "hasAdvancedFormFields": false,
    "hasPersistedData": false,
    "hasSyncOrBackup": false,
    "hasAuthoritativeVersionedData": false,
    "hasAppLock": false,
    "hasGeneratedAssistance": false,
    "hasFixedBottomControls": false,
    "hasTranslucentSurfaces": false,
    "hasSearch": false,
    "hasDetails": false,
    "hasSheets": false,
    "hasFullscreen": false,
    "hasOnboarding": false,
    "hasStateSurfaces": false,
    "hasProductionBackend": false,
    "hasRepresentativeUserData": false,
    "hasAsyncDerivedState": false,
    "hasDerivedState": false,
    "hasRemoteDestructiveOrAccessMutations": false,
    "hasCloudSharingOrAccessControl": false,
    "hasRelationshipBearingDeletion": false,
    "hasMaterialDeterministicEngine": false,
    "hasFeatureFlaggedPermissionedCapability": false,
    "hasCompactSurfaces": false,
    "hasAIReleaseReview": false,
    "hasPostReleaseMonitoring": false,
    "hasOnDeviceAI": false,
    "hasCloudAI": false,
    "hasAITools": false,
    "hasAdaptiveAI": false,
    "hasAIPersonalization": false,
    "hasPortableBackup": false,
    "hasUserRestore": false,
    "hasAppUpdateNotice": false,
    "hasInAppLanguageSelector": false,
    "hasPersistentSharedContent": false,
    "hasAuthoritativeFunctionalSources": false,
    "hasRemoteInviteShareAccessFlow": false
  },
  "supportedLocalizations": [
    "sk"
  ],
  "localization": {
    "files": [],
    "requiredKeys": []
  },
  "projectMetadata": {
    "projectFile": null,
    "releasePhase": "release-candidate"
  },
  "rules": {
    "STD-CONF-001": {
      "mode": "static",
      "status": "implemented",
      "evidence": {
        "files": [
          "STANDARD_CONFORMANCE.json"
        ]
      }
    },
    "STD-EVIDENCE-001": {
      "mode": "static",
      "status": "pending",
      "evidence": {
        "notes": [
          "Record exact app version/build/device/OS/date for runtime evidence."
        ]
      }
    },
    "STD-RELEASE-006": {
      "mode": "runtime",
      "status": "pending",
      "runtimeGate": "RUNTIME_ACCEPTANCE.md#release-candidate-quality-gate"
    },
    "STD-DIAG-001": {
      "mode": "runtime",
      "status": "pending",
      "runtimeGate": "RUNTIME_ACCEPTANCE.md#full-app-check"
    },
    "STD-DIAG-002": {
      "mode": "runtime",
      "status": "pending",
      "runtimeGate": "RUNTIME_ACCEPTANCE.md#diagnostic-findings"
    },
    "STD-EVIDENCE-002": {
      "mode": "static",
      "status": "pending",
      "evidence": {
        "files": [
          "RELEASE_INSPECTOR_REPORT.md"
        ]
      }
    },
    "STD-BACKUP-001": {
      "mode": "unit",
      "status": "pending",
      "test": "BackupContractTests/testPortableArchiveIntegrity"
    },
    "STD-BACKUP-002": {
      "mode": "runtime",
      "status": "pending",
      "runtimeGate": "RUNTIME_ACCEPTANCE.md#restore-and-rollback"
    },
    "STD-SHARE-001": {
      "mode": "runtime",
      "status": "pending",
      "runtimeGate": "RUNTIME_ACCEPTANCE.md#recipient-content-parity"
    },
    "STD-UPDATE-001": {
      "mode": "unit",
      "status": "pending",
      "test": "AppUpdateServiceTests/testVersionSnoozeAndFailureRetry"
    }
  },
  "runtimeAcceptanceFile": "RUNTIME_ACCEPTANCE.md",
  "exceptions": {},
  "screenAudit": {
    "families": {
      "SCREEN-ROOT": {
        "status": "pending",
        "screens": [
          "<primary root screen>"
        ],
        "evidence": [
          "RUNTIME_ACCEPTANCE.md#SCREEN-ROOT"
        ]
      }
    }
  },
  "ai": {
    "features": [],
    "featureContract": {
      "required": [
        "id",
        "riskProfile",
        "execution",
        "runtimeKind",
        "fallbackKind"
      ],
      "runtimeKind": [
        "model",
        "deterministic"
      ],
      "fallbackKind": [
        "none",
        "model",
        "deterministic"
      ],
      "note": "runtimeKind/fallbackKind distinguish model AI from deterministic non-generative fallback; remove this documentation object in an app manifest if the app keeps only ai.features."
    }
  },
  "executionEvidence": {
    "file": "Evidence/STANDARD_EXECUTION_RESULTS.json"
  }
}
