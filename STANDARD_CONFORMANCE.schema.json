{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IbaJuraj app conformance manifest",
  "type": "object",
  "required": [
    "standardVersion",
    "standardCandidate",
    "app",
    "capabilities",
    "screenAudit",
    "rules",
    "exceptions"
  ],
  "properties": {
    "standardVersion": {
      "const": "1.9.0"
    },
    "standardCandidate": {
      "const": "RC4"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "productId"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "hasPortableBackup": {
          "type": "boolean"
        },
        "hasUserRestore": {
          "type": "boolean"
        },
        "hasAppUpdateNotice": {
          "type": "boolean"
        },
        "hasInAppLanguageSelector": {
          "type": "boolean"
        },
        "hasPersistentSharedContent": {
          "type": "boolean"
        },
        "hasAuthoritativeFunctionalSources": {
          "type": "boolean"
        },
        "hasRemoteInviteShareAccessFlow": {
          "type": "boolean"
        }
      }
    },
    "supportedLocalizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localization": {
      "type": "object"
    },
    "projectMetadata": {
      "type": "object",
      "properties": {}
    },
    "rules": {
      "type": "object"
    },
    "runtimeAcceptanceFile": {
      "type": [
        "string",
        "null"
      ]
    },
    "exceptions": {
      "type": "object"
    },
    "screenAudit": {
      "type": "object",
      "required": [
        "families"
      ],
      "properties": {
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "screens"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "pending",
                  "exception"
                ]
              },
              "screens": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "adr": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "riskProfile",
              "execution",
              "runtimeKind",
              "fallbackKind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "riskProfile": {
                "enum": [
                  "advisory",
                  "derived",
                  "action-capable",
                  "adaptive"
                ]
              },
              "execution": {
                "enum": [
                  "on-device",
                  "cloud",
                  "hybrid"
                ]
              },
              "personalization": {
                "type": "boolean"
              },
              "tools": {
                "type": "boolean"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runtimeKind": {
                "enum": [
                  "model",
                  "deterministic"
                ]
              },
              "fallbackKind": {
                "enum": [
                  "none",
                  "model",
                  "deterministic"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "executionEvidence": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "object",
      "description": "Non-blocking decisions for applicable SHOULD rules; deferred decisions explain why.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "enum": [
              "adopted",
              "deferred"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
