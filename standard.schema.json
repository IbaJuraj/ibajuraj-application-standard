{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibajuraj.github.io/standard/standard.schema.json",
  "title": "IbaJuraj Application Standard metadata",
  "type": "object",
  "required": [
    "name",
    "version",
    "status",
    "breakingChange",
    "contracts",
    "documents",
    "source"
  ],
  "properties": {
    "name": {
      "const": "IbaJuraj Application Standard"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "active",
        "release-candidate",
        "deprecated"
      ]
    },
    "releasedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "rcDate": {
      "type": "string"
    },
    "minimumSupportedVersion": {
      "type": "string"
    },
    "breakingChange": {
      "type": "boolean"
    },
    "inherits": {
      "type": "object"
    },
    "normativeKeywords": {
      "type": "array"
    },
    "adoptionLevels": {
      "type": "array"
    },
    "contracts": {
      "type": "object"
    },
    "documents": {
      "type": "object"
    },
    "source": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
